<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KrishiMitr" parent="android:Theme.Material.Light.NoActionBar">

        <item name="android:windowBackground" >@color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal_700</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/totoro</item>
        <item name="postSplashScreenTheme">@style/Theme.KrishiMitr</item>
    </style>

</resources>